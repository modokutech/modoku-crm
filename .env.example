# Copy this file to .env and fill in your values:
#   cp .env.example .env
#
# .env is already in .gitignore, so it's safe to put real credentials here —
# it never gets committed. run.py loads it automatically (via python-dotenv)
# every time you start the app with `python run.py`, so you only set these
# once instead of re-exporting them in every new Terminal tab.

# --- Outgoing email (Gmail App Password) ---
# See README.md "Setting up email" for full step-by-step instructions.
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=1
MAIL_USERNAME=youraddress@gmail.com
MAIL_PASSWORD=your16characterapppassword
MAIL_FROM_NAME=Modoku Tech
# Optional — defaults to MAIL_USERNAME if not set:
# MAIL_FROM_ADDRESS=youraddress@gmail.com

# --- AI attendance matching (optional) ---
# See README.md "Setting up AI attendance matching" for full instructions.
# Without this set, that feature stays hidden and everything else works as normal.
# ANTHROPIC_API_KEY=sk-ant-your-key-here

# --- Other optional settings (uncomment/edit as needed) ---
# SECRET_KEY=change-this-to-something-random
# PORT=5000
